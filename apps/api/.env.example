# NutriSense Backend Environment Variables
# Copy this file to .env and replace placeholders with your credentials.

APP_NAME="NutriSense API"
ENV=development
APP_TIMEZONE=Asia/Kolkata
# Database (SQLite for local, PostgreSQL / Neon for production)
DATABASE_URL=sqlite:///./nutrisense.db
# DATABASE_URL_UNPOOLED=postgresql://user:password@ep-direct.region.aws.neon.tech/neondb?sslmode=require
# Production Neon connection string format (pooled):
# DATABASE_URL=postgresql://user:password@ep-pooler.region.aws.neon.tech/neondb?sslmode=require
JWT_SECRET=your_jwt_secret_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,http://localhost:8443,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:5173,http://127.0.0.1:8443

# Food & Nutrition APIs
FOOD_PROVIDER=local
USDA_API_KEY=your_usda_api_key_here
ENABLE_OPEN_FOOD_FACTS=true

# AI Vision Providers
VISION_PROVIDER=trained_model
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_VISION_MODEL=google/gemma-4-26b-a4b-it:free

LOG_LEVEL=INFO
SEED_ON_STARTUP=true
